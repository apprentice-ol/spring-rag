<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.jjx.customer</groupId>
    <artifactId>customer-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>customer-platform</name>
    <description>基于 Spring AI 1.1 的 RAG 文档入库与问答（ragent 的 Spring AI 重写版）</description>

    <modules>
        <!-- 新 agent 内核（零依赖底座，放在最前表达 reactor 顺序；自 agent-framework 仓库源码并入） -->
        <module>platform-agent-core</module>
        <module>platform-shared</module>
        <module>platform-observe</module>
        <module>platform-cache</module>
        <module>platform-knowledge</module>
        <module>platform-prompt</module>
        <module>platform-ingestion</module>
        <module>platform-storage</module>
        <module>platform-business</module>
        <module>platform-delivery</module>
        <module>platform-eval</module>
        <module>platform-mcp</module>
        <module>platform-common</module>
        <module>platform-console</module>
        <module>platform-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>1.1.2</spring-ai.version>
        <!-- OpenTelemetry instrumentation 组件（logback appender 等）版本统一收口；不引 BOM 以免覆盖 Boot 管理的 OTel 核心版本 -->
        <opentelemetry.instrumentation.version>2.15.0-alpha</opentelemetry.instrumentation.version>
        <mybatis-plus.version>3.5.14</mybatis-plus.version>
        <rocketmq-spring.version>2.3.5</rocketmq-spring.version>
        <knife4j.version>4.5.0</knife4j.version>
        <hutool-all.version>5.8.37</hutool-all.version>
        <okhttp.version>4.12.0</okhttp.version>
        <commonmark.version>0.22.0</commonmark.version>
        <redisson.version>3.45.1</redisson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.jjx.customer</groupId>
                <artifactId>platform-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jjx.customer</groupId>
                <artifactId>platform-cache</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jjx.customer</groupId>
                <artifactId>platform-observe</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jjx.customer</groupId>
                <artifactId>platform-knowledge</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jjx.customer</groupId>
                <artifactId>platform-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jjx.customer</groupId>
                <artifactId>platform-prompt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jjx.customer</groupId>
                <artifactId>platform-ingestion</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jjx.customer</groupId>
                <artifactId>platform-business</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jjx.customer</groupId>
                <artifactId>platform-delivery</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jjx.customer</groupId>
                <artifactId>platform-eval</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 新 agent 内核（源码并入本仓；包名保留 com.agentframework，Maven 坐标与仓内统一） -->
            <dependency>
                <groupId>com.jjx.customer</groupId>
                <artifactId>platform-agent-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jjx.customer</groupId>
                <artifactId>platform-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jjx.customer</groupId>
                <artifactId>platform-bootstrap</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Lombok：所有模块共享 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Test：所有模块共享 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
