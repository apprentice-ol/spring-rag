# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
*.jar
*.war

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Env / secrets（真实配置绝不提交：.env / .env.local / .env.prod 全部 ignore；
# .env.example 是占位模板（xxx/假值），故意提交供他人参考）
.env
.env.*
!.env.example
application-local.yaml
application-prod.yaml

# Frontend（node_modules 依赖 + dist 构建产物；前端源码 frontend/src 正常提交）
node_modules/
frontend/dist/
# 前端构建产物：build-local.sh 的 [2/3] 步把 frontend/dist/* 拷到这里、由 Spring Boot 打进 jar。
# 与上面的 frontend/dist 是同一份东西，同样不入库——克隆后跑一次 build-local.sh 即可生成。
# （旧注释里提到的 rag-core/src/main/resources/static 模块已不存在，规则随之修正）
platform-bootstrap/src/main/resources/static/

# 运行时数据（LiveRAG 等下载缓存，运行时生成；评测 parquet 数据集保留入库）
/data/

# Python 脚本缓存
__pycache__/
*.pyc

# Binary 安装包（pg-search.deb 等 68MB 大文件不入 git；本地 docker build 时自行放置，
# 见 docker/postgres/README.md）
*.deb
