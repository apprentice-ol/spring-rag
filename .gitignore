# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
*.jar
*.war

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Env / secrets（真实配置绝不提交：.env / .env.local / .env.prod 全部 ignore；
# .env.example 是占位模板（xxx/假值），故意提交供他人参考）
.env
.env.*
!.env.example
application-local.yaml
application-prod.yaml

# Frontend（node_modules 依赖 + dist 构建产物；前端源码 frontend/src 正常提交）
node_modules/
frontend/dist/
# 前端构建产物：build-local.sh 的 [2/3] 步把 frontend/dist/* 拷到这里、由 Spring Boot 打进 jar。
# 与上面的 frontend/dist 是同一份东西，同样不入库——克隆后跑一次 build-local.sh 即可生成。
# （旧注释里提到的 rag-core/src/main/resources/static 模块已不存在，规则随之修正）
platform-bootstrap/src/main/resources/static/

# 运行时数据（LiveRAG 等下载缓存，运行时生成；评测 parquet 数据集保留入库）
/data/

# Python 脚本缓存
__pycache__/
*.pyc

# Binary 安装包（pg-search.deb 等 68MB 大文件不入 git；本地 docker build 时自行放置，
# 见 docker/postgres/README.md）
*.deb

# 工具/流水线本地状态与分发包目录（不入库）
.apifox/
dist/

# ===== Claude Code 本地状态 / 流水线产物（2026-10-11 整理）=====
# 本地个人配置（权限白名单、MCP 启用记录）——不入库
.claude/settings.local.json
.claude/settings.local.*
# 流水线运行台账与证据（reports 机制说明 README 保留入库）
.claude/pipeline/reports/*
!.claude/pipeline/reports/README.md
# api-test 用例工作库（由 apifox-gen-cases.py 重新生成，不入库）
.claude/pipeline/apifox/

# ACL 恢复/诊断产物（一次性，2026-10-11）
/acl-recovery/

# oo_trace_query.py 默认输出
/trace-*.json
