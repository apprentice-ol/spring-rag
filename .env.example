# 环境配置约定（真实值绝不进 git）：
#   - 本地开发：cp .env.example .env，填真实值（.env 已被 .gitignore 排除）
#   - 多环境可选：.env.local / .env.prod（同样 ignore；compose 用 --env-file .env.prod 指定）
#   - 本文件是占位模板（示例一律 xxx 或 dev 假值），故意提交供他人参考
# docker compose（同目录 .env 自动注入容器）与 Spring Boot（application.yaml 的 spring.config.import）共用此文件。

# ====================================================================
# LLM / AI API Keys
# ====================================================================
# DeepSeek（chat 全局模型）：https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=
# 阿里百炼（embedding / rerank / VLM 共用同一 key）：https://bailian.console.aliyun.com → API-KEY
BAILIAN_API_KEY=
# MinerU（PDF/Word/PPT 结构化解析）：https://mineru.net → API
MINERU_API_KEY=

# ====================================================================
# 可观测性：OTel Collector 开关
# true  = 应用统一发到 otel-collector，由 collector 扇出到后端（默认，推荐）
# false = 应用直连 OpenObserve / Langfuse 的 OTLP 入口
# ====================================================================
TELEMETRY_COLLECTOR_ENABLED=
# Collector OTLP HTTP 基础地址，默认 http://localhost:4318
OBSERVE_OTLP_ENDPOINT=
# Collector 如果开启鉴权，填 Authorization header；本地开发一般留空
TELEMETRY_COLLECTOR_AUTHORIZATION=

# ====================================================================
# 可观测性：OpenObserve（账号一律自设强密码，示例用 xxx；本地开发默认见 compose 的 dev 假默认）
# ====================================================================
# OpenObserve API 根地址（到组织 default）
OPENOBSERVE_URL=
# OpenObserve Web UI 地址（浏览器可达，前端链路追踪页跳转用）
OPENOBSERVE_WEB_URL=
# 日志诊断读取侧账号（生产务必覆盖默认值）
OO_USERNAME=
OO_PASSWORD=
# collector 写 OpenObserve 的 OTLP Basic Auth：base64(账号:密码)，compose 已内置默认
OO_AUTH=

# ====================================================================
# 可观测性：Langfuse（账号首启在 UI 自行注册，勿写真实值进任何入库文件）
# ====================================================================
# Langfuse Web UI 地址
LANGFUSE_URL=
# OTLP 鉴权 public/secret key（Langfuse UI → 项目设置 → API Keys 获取）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# collector 写 Langfuse 的 OTLP Basic Auth：base64(pk-lf:sk-lf)
LANGFUSE_AUTH=

# ====================================================================
# 生产服务器 IP（仅 docker-compose.server.yml 用；本地开发留空即可）
# ====================================================================
SERVER_IP=

# ====================================================================
# 部署服务账号密码（原硬编码在 compose/配置，现统一 .env 注入）
# 留空时各文件回退到 ${VAR:-默认值}（见 docker-compose*.yml / application*.yaml）；
# 生产务必显式填写并区别于默认值。
# ====================================================================
POSTGRES_USER=
POSTGRES_PASSWORD=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
ZO_ROOT_USER_EMAIL=
ZO_ROOT_USER_PASSWORD=
# 前端「链路追踪」页展示的 OO 只读账号（ObserveController 下发，登录 OO UI 看链路用）
OO_VIEWER_EMAIL=
OO_VIEWER_PASSWORD=
