<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Spring Boot 默认变量和 CONSOLE appender（含 traceId 自动注入） -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <!-- OpenObserve 异步日志推送。
         url 用环境变量 OPENOBSERVE_URL（与 application.yaml 的 openobserve.url 占位符同名，单一变量名；
         默认 localhost:5080 本地即达；服务器部署 export OPENOBSERVE_URL=http://<ip>:5080/api/default）。
         password 用环境变量 OO_PASSWORD 覆盖。 -->
    <appender name="OPENOBSERVE" class="com.nageoffer.ai.rag.config.log.OpenObserveAppender">
        <url>${OPENOBSERVE_URL:-http://localhost:5080/api/default}</url>
        <stream>springai-rag_logs</stream>
        <service>springai-rag</service>
        <username>admin@openobserve.io</username>
        <password>${OO_PASSWORD:-OpenObserve@2026}</password>
        <batchSize>200</batchSize>
        <flushIntervalMillis>5000</flushIntervalMillis>
        <queueCapacity>10000</queueCapacity>
    </appender>

    <!-- 日志级别由 application.yaml 的 logging.level 控制 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OPENOBSERVE"/>
    </root>
</configuration>
