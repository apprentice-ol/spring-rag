<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="bean-lifecycle" name="Spring Bean 生命周期（详细版）">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Spring Bean 生命周期（详细版）" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="380" y="0" width="480" height="30" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="① 实例化 Instantiation" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="360" height="340" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="② 属性填充 Populate" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="360" height="350" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="③ 初始化 Initialization" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="1230" width="360" height="420" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="④ 销毁 Destroy（容器关闭时）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;align=left;spacingLeft=8;fontStyle=1;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="820" y="1250" width="360" height="530" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;容器启动&lt;/b&gt;&lt;br&gt;扫描注解 / 解析配置类" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="40" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;注册 BeanDefinition&lt;/b&gt;&lt;br&gt;BeanDefinitionRegistry · BeanDefinitionMap" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3a" value="&lt;b&gt;BeanDefinitionRegistryPostProcessor&lt;/b&gt;&lt;br&gt;postProcessBeanDefinitionRegistry()&lt;br&gt;动态注册 / 修改 Bean 定义" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="70" y="230" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n3b" value="&lt;b&gt;BeanFactoryPostProcessor&lt;/b&gt;&lt;br&gt;postProcessBeanFactory()&lt;br&gt;占位符解析等（ConfigurationClassPostProcessor）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="70" y="340" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;实例化前回调&lt;/b&gt;&lt;br&gt;InstantiationAwareBeanPostProcessor&lt;br&gt;.postProcessBeforeInstantiation()&lt;br&gt;（可短路直接返回代理）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="g1">
          <mxGeometry x="30" y="40" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;推断并反射调用构造方法&lt;/b&gt;&lt;br&gt;得到原始对象（@Autowired 构造优先）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g1">
          <mxGeometry x="30" y="140" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n5b" value="&lt;b&gt;合并定义回调&lt;/b&gt;&lt;br&gt;.postProcessMergedBeanDefinition()&lt;br&gt;收集 @Resource / @Autowired 注入元数据" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="g1">
          <mxGeometry x="30" y="230" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;实例化后回调&lt;/b&gt;&lt;br&gt;.postProcessAfterInstantiation()&lt;br&gt;返回 false 可跳过属性填充" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="g2">
          <mxGeometry x="30" y="40" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;属性填充&lt;/b&gt;&lt;br&gt;.postProcessProperties()&lt;br&gt;@Autowired / @Value / @Resource 注入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="g2">
          <mxGeometry x="30" y="150" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;Aware 回调 ①（直接回调）&lt;/b&gt;&lt;br&gt;BeanNameAware / BeanClassLoaderAware&lt;br&gt;/ BeanFactoryAware" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g2">
          <mxGeometry x="30" y="260" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;初始化前回调&lt;/b&gt;&lt;br&gt;.postProcessBeforeInitialization()&lt;br&gt;@PostConstruct · ApplicationContextAware ②" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="g3">
          <mxGeometry x="30" y="40" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;InitializingBean&lt;/b&gt;&lt;br&gt;.afterPropertiesSet()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g3">
          <mxGeometry x="30" y="150" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;自定义 init-method&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="g3">
          <mxGeometry x="30" y="240" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;初始化后回调&lt;/b&gt;&lt;br&gt;.postProcessAfterInitialization()&lt;br&gt;AOP 代理通常在此生成" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="g3">
          <mxGeometry x="30" y="320" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;Bean 就绪&lt;/b&gt;&lt;br&gt;单例放入单例池&lt;br&gt;业务长期使用" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="620" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;SmartInitializingSingleton&lt;/b&gt;&lt;br&gt;.afterSingletonsInstantiated()&lt;br&gt;（所有单例就绪后回调一次）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="470" y="850" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="&lt;b&gt;finishRefresh()&lt;/b&gt;&lt;br&gt;ContextRefreshedEvent / LifecycleProcessor.onRefresh()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="470" y="980" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;容器关闭&lt;/b&gt;&lt;br&gt;context.close() / registerShutdownHook()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="g4">
          <mxGeometry x="30" y="40" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;@PreDestroy&lt;/b&gt;&lt;br&gt;DestructionAwareBeanPostProcessor 回调" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="g4">
          <mxGeometry x="30" y="140" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;DisposableBean&lt;/b&gt;&lt;br&gt;.destroy()" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="g4">
          <mxGeometry x="30" y="240" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;自定义 destroy-method&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="g4">
          <mxGeometry x="30" y="340" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="生命周期结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="g4">
          <mxGeometry x="30" y="440" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;ⓘ 循环依赖三级缓存&lt;/b&gt;&lt;br&gt;仅当发生循环依赖：getEarlyBeanReference()&lt;br&gt;提前暴露早期引用，仅限单例 +&lt;br&gt;setter/字段注入（构造器注入无解）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
