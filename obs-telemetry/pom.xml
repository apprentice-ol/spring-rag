<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nageoffer.ai</groupId>
        <artifactId>springai-rag</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>obs-telemetry</artifactId>
    <name>obs-telemetry</name>
    <description>公共可观测组件（Spring Boot Starter）：基于 OTel + micrometer 的 @TraceStep / Telemetry / ObsLogger / sink 责任链 / 跨线程传播，可被任意服务复用。只依赖 OTel/micrometer/Spring/Java。</description>

    <dependencies>
        <!-- Spring 基础（spring-context / slf4j / logging） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- AOP：@TraceStep / @TraceConversation 切面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- 自动装配（@AutoConfiguration / @ConfigurationProperties） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- micrometer Observation（ObservationRegistry → OTel child span） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation</artifactId>
        </dependency>

        <!-- OpenTelemetry API（Span / OpenTelemetry / Tracer / Context）；运行时 bean 由引入方应用的 tracing-bridge 提供 -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
        </dependency>

        <!-- OTLP Logs 的 logback appender（optional）。
             宿主如果希望日志统一走 OTLP Logs，需要自行引入该依赖；本模块提供 appender 初始化。 -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
            <version>2.15.0-alpha</version>
            <optional>true</optional>
        </dependency>

        <!-- micrometer Context Propagation（ThreadLocalAccessor：MDC / OTel Context / ConversationContext 跨线程透传） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>

        <!-- Reactor（Flux 流式步骤装饰 + Hooks.enableAutomaticContextPropagation） -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- Spring Web MVC（optional）：TraceStepAspect 支持 SseEmitter/ResponseBodyEmitter 流式返回。
             非-web 服务可不带（SSE 分支不触发）；web 服务经 spring-boot-starter-web 自动传递引入。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Gson（Summarizer 对象摘要 / StructuredLog JSON 序列化） -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <!-- Spring AI 观察适配（可选）：仅在宿主引入 Spring AI 时由 @ConditionalOnClass 激活。
             optional 保证不会传递给未使用 Spring AI 的宿主项目。 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
